_preview":true,"column_alignment":"center","show_stars":true,"stars_color":"#ffd700","show_quotes":false,"quotes_color_scheme":"accent-2","background_style":"primary","color_scheme":"background-1","padding_top":48,"padding_bottom":48,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#2e2a39"}},"ds_icon_bar_HaUALW":{"type":"ds-icon-bar","blocks":{"column_4zRAFa":{"type":"column","settings":{"icon":"truck","title":"Free Shipping","text":"<p>Delivered effortlessly to your doorstep, no matter where you call home.<\/p>"}},"column_KRBcLg":{"type":"column","settings":{"icon":"heart","title":"Happiness Guarantee","text":"<p>If it’s not perfect, we’ll make it right every time.<\/p>"}},"column_wbHVEM":{"type":"column","settings":{"icon":"check_mark","title":"Quality You Can Trust","text":"<p>Every product is tested and approved for safety and durability.<\/p>"}},"column_aHTPij":{"type":"column","settings":{"icon":"chat_bubble","title":"Top Tier Support","text":"<p>Real people, real help. Here whenever you need us.<\/p>"}}},"block_order":["column_4zRAFa","column_KRBcLg","column_wbHVEM","column_aHTPij"],"disabled":true,"settings":{"title":"Our Promise To You:","heading_size":"h1","text":"<p>Every order protected. Every question answered. Every customer valued.<\/p>","icon_size":"small","columns_desktop":4,"icon_color":"accent-1","background_style":"none","color_scheme":"background-2","columns_mobile":"1","swipe_on_mobile":true,"padding_top":48,"padding_bottom":56,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#2e2a39"}},"custom_liquid_B3Fk9g":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<style>\n  \/* Remove spacing added by the Custom Liquid section *\/\n  #shopify-section-{{ section.id }} {\n    margin: 0 !important;\n    padding: 0 !important;\n    background: #f7f4ef;\n  }\n\n  #shopify-section-{{ section.id }} > div,\n  #shopify-section-{{ section.id }} .custom-liquid,\n  #shopify-section-{{ section.id }} .page-width,\n  #shopify-section-{{ section.id }} [class*=\"section-\"][class*=\"-padding\"] {\n    margin-top: 0 !important;\n    margin-bottom: 0 !important;\n    padding-bottom: 0 !important;\n  }\n\n  #shopify-section-{{ section.id }} + .shopify-section {\n    margin-top: 0 !important;\n  }\n\n  #theravique-faq-{{ section.id }} {\n    background: #f7f4ef;\n    color: #24211e;\n    margin: 0;\n    padding: 64px 20px 24px;\n  }\n\n  #theravique-faq-{{ section.id }} * {\n    box-sizing: border-box;\n  }\n\n  #theravique-faq-{{ section.id }} .theravique-faq__container {\n    width: 100%;\n    max-width: 920px;\n    margin: 0 auto;\n  }\n\n  #theravique-faq-{{ section.id }} .theravique-faq__header {\n    margin-bottom: 38px;\n    text-align: center;\n  }\n\n  #theravique-faq-{{ section.id }} .theravique-faq__title {\n    margin: 0 0 10px;\n    color: #211e1b;\n    font-size: 38px;\n    font-weight: 700;\n    line-height: 1.2;\n    letter-spacing: -0.4px;\n  }\n\n  #theravique-faq-{{ section.id }} .theravique-faq__subtitle {\n    max-width: 620px;\n    margin: 0 auto;\n    color: #6c6761;\n    font-size: 16px;\n    line-height: 1.7;\n  }\n\n  #theravique-faq-{{ section.id }} .theravique-faq__list {\n    border-top: 1px solid #d9d1c7;\n  }\n\n  #theravique-faq-{{ section.id }} .theravique-faq__item {\n    margin: 0;\n    border-bottom: 1px solid #d9d1c7;\n  }\n\n  #theravique-faq-{{ section.id }} .theravique-faq__question {\n    position: relative;\n    display: flex;\n    width: 100%;\n    align-items: center;\n    padding: 22px 48px 22px 0;\n    color: #24211e;\n    cursor: pointer;\n    list-style: none;\n    font-size: 16px;\n    font-weight: 650;\n    line-height: 1.45;\n  }\n\n  #theravique-faq-{{ section.id }}\n  .theravique-faq__question::-webkit-details-marker {\n    display: none;\n  }\n\n  #theravique-faq-{{ section.id }} .theravique-faq__question::before,\n  #theravique-faq-{{ section.id }} .theravique-faq__question::after {\n    content: \"\";\n    position: absolute;\n    top: 50%;\n    right: 4px;\n    width: 16px;\n    height: 2px;\n    background: #6d2638;\n    transform: translateY(-50%);\n    transition: transform 0.2s ease;\n  }\n\n  #theravique-faq-{{ section.id }} .theravique-faq__question::after {\n    transform: translateY(-50%) rotate(90deg);\n  }\n\n  #theravique-faq-{{ section.id }}\n  .theravique-faq__item[open]\n  .theravique-faq__question::after {\n    transform: translateY(-50%) rotate(0deg);\n  }\n\n  #theravique-faq-{{ section.id }} .theravique-faq__answer {\n    padding: 0 48px 22px 0;\n    color: #5f5a54;\n    font-size: 15px;\n    line-height: 1.75;\n  }\n\n  #theravique-faq-{{ section.id }} .theravique-faq__answer p {\n    margin: 0;\n  }\n\n  @media screen and (max-width: 749px) {\n    #theravique-faq-{{ section.id }} {\n      padding: 42px 18px 14px !important;\n    }\n\n    #theravique-faq-{{ section.id }} .theravique-faq__header {\n      margin-bottom: 26px;\n    }\n\n    #theravique-faq-{{ section.id }} .theravique-faq__title {\n      font-size: 28px;\n    }\n\n    #theravique-faq-{{ section.id }} .theravique-faq__subtitle {\n      font-size: 14px;\n      line-height: 1.6;\n    }\n\n    #theravique-faq-{{ section.id }} .theravique-faq__question {\n      padding: 18px 40px 18px 0;\n      font-size: 14px;\n    }\n\n    #theravique-faq-{{ section.id }} .theravique-faq__answer {\n      padding: 0 36px 18px 0;\n      font-size: 14px;\n      line-height: 1.65;\n    }\n\n    #shopify-section-{{ section.id }},\n    #shopify-section-{{ section.id }} > div,\n    #shopify-section-{{ section.id }} .custom-liquid,\n    #shopify-section-{{ section.id }} .page-width {\n      margin-bottom: 0 !important;\n      padding-bottom: 0 !important;\n    }\n  }\n<\/style>\n\n<section\n  id=\"faq\"\n  class=\"theravique-faq\"\n  aria-labelledby=\"theravique-faq-title-{{ section.id }}\"\n>\n  <div\n    id=\"theravique-faq-{{ section.id }}\"\n    class=\"theravique-faq__inner\"\n  >\n    <div class=\"theravique-faq__container\">\n\n      <div class=\"theravique-faq__header\">\n        <h2\n          id=\"theravique-faq-title-{{ section.id }}\"\n          class=\"theravique-faq__title\"\n        >\n          Frequently Asked Questions\n        <\/h2>\n\n        <p class=\"theravique-faq__subtitle\">\n          Everything you need to know about our editions,\n          packaging, shipping and order support.\n        <\/p>\n      <\/div>\n\n      <div class=\"theravique-faq__list\">\n\n        <details class=\"theravique-faq__item\">\n          <summary class=\"theravique-faq__question\">\n            What exactly will I receive?\n          <\/summary>\n\n          <div class=\"theravique-faq__answer\">\n            <p>\n              You will receive the edition, cover design and quantity\n              selected on the product page. Please review the product\n              photographs, variant selection and “What You’ll Receive”\n              information carefully before completing your order.\n            <\/p>\n          <\/div>\n        <\/details>\n\n        <details class=\"theravique-faq__item\">\n          <summary class=\"theravique-faq__question\">\n            Are the books written in English?\n          <\/summary>\n\n          <div class=\"theravique-faq__answer\">\n            <p>\n              Unless otherwise stated on the product page, our editions\n              are printed in English. Language, page count, dimensions\n              and other edition details are listed individually for\n              each product.\n            <\/p>\n          <\/div>\n        <\/details>\n\n        <details class=\"theravique-faq__item\">\n          <summary class=\"theravique-faq__question\">\n            How are the books packaged?\n          <\/summary>\n\n          <div class=\"theravique-faq__answer\">\n            <p>\n              Every order is inspected before dispatch and packed with\n              protective materials designed to help prevent damage to\n              the cover, spine, corners and decorative page edges during\n              transportation.\n            <\/p>\n          <\/div>\n        <\/details>\n\n        <details class=\"theravique-faq__item\">\n          <summary class=\"theravique-faq__question\">\n            How long does order processing take?\n          <\/summary>\n\n          <div class=\"theravique-faq__answer\">\n            <p>\n              Processing times vary by edition and order volume. The\n              estimated processing period is shown on the relevant\n              product page. Business days do not include weekends or\n              public holidays.\n            <\/p>\n          <\/div>\n        <\/details>\n\n        <details class=\"theravique-faq__item\">\n          <summary class=\"theravique-faq__question\">\n            Will I receive tracking information?\n          <\/summary>\n\n          <div class=\"theravique-faq__answer\">\n            <p>\n              When tracking is available, a shipping confirmation email\n              containing your tracking number will be sent after your\n              order has been dispatched. Tracking may take a short time\n              to update after the carrier receives the parcel.\n            <\/p>\n          <\/div>\n        <\/details>\n\n        <details class=\"theravique-faq__item\">\n          <summary class=\"theravique-faq__question\">\n            What should I do if my book arrives damaged?\n          <\/summary>\n\n          <div class=\"theravique-faq__answer\">\n            <p>\n              Please contact us as soon as possible after delivery.\n              Include your order number, a photograph of the shipping\n              packaging and clear photographs showing the damaged area.\n              Our support team will review the issue and assist with the\n              appropriate next step.\n            <\/p>\n          <\/div>\n        <\/details>\n\n        <details class=\"theravique-faq__item\">\n          <summary class=\"theravique-faq__question\">\n            Can I change or cancel my order?\n          <\/summary>\n\n          <div class=\"theravique-faq__answer\">\n            <p>\n              Contact us as soon as possible after placing your order.\n              We will do our best to assist, but changes and cancellations\n              cannot be guaranteed after an order has entered processing\n              or has already been dispatched.\n            <\/p>\n          <\/div>\n        <\/details>\n\n        <details class=\"theravique-faq__item\">\n          <summary class=\"theravique-faq__question\">\n            Can I return or exchange my order?\n          <\/summary>\n\n          <div class=\"theravique-faq__answer\">\n            <p>\n              Return eligibility depends on the condition of the book\n              and the type of edition purchased. Items must generally\n              remain unused and in their original condition. Please\n              review our refund policy or contact our support team before\n              returning an item.\n            <\/p>\n          <\/div>\n        <\/details>\n\n      <\/div>\n    <\/div>\n  <\/div>\n<\/section>","color_scheme":"","padding_top":40,"padding_bottom":52}}},"order":["hero_banner_BWthU6","as_seen_on_6gEx6m","rich_text_mXYcNH","multirow_ftq6YR","ds_horizontal_ticker_Tfpimk","ds_testimonials_F4dxEV","ds_icon_bar_HaUALW","custom_liquid_B3Fk9g"]}