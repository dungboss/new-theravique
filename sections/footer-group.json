{"name":"t:sections.footer.name","type":"footer","sections":{"custom_liquid_7zKimE":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<style>\n  \/* =====================================================\n     REMOVE CUSTOM LIQUID DEFAULT SPACING\n  ===================================================== *\/\n\n  #shopify-section-{{ section.id }} {\n    width: 100%;\n    margin: 0 !important;\n    padding: 0 !important;\n    background: #17120f;\n  }\n\n  #shopify-section-{{ section.id }} > div,\n  #shopify-section-{{ section.id }} .custom-liquid,\n  #shopify-section-{{ section.id }} .page-width,\n  #shopify-section-{{ section.id }}\n  [class*=\"section-\"][class*=\"-padding\"] {\n    width: 100% !important;\n    max-width: none !important;\n    margin: 0 !important;\n    padding: 0 !important;\n  }\n\n  \/* =====================================================\n     FOOTER BASE\n  ===================================================== *\/\n\n  #theravique-footer-{{ section.id }} {\n    --footer-bg: #17120f;\n    --footer-text: #f6efe7;\n    --footer-muted: #bcb0a5;\n    --footer-accent: #ddb36f;\n    --footer-accent-hover: #ecd09f;\n    --footer-border: rgba(255, 255, 255, 0.13);\n\n    width: 100%;\n    margin: 0;\n    padding: 48px 24px 24px;\n    overflow: hidden;\n    background: var(--footer-bg);\n    color: var(--footer-text);\n  }\n\n  #theravique-footer-{{ section.id }} * {\n    box-sizing: border-box;\n  }\n\n  #theravique-footer-{{ section.id }} .tv-footer__container {\n    width: 100%;\n    max-width: 1120px;\n    margin: 0 auto;\n  }\n\n  #theravique-footer-{{ section.id }} .tv-footer__grid {\n    display: grid;\n    grid-template-columns: 1.15fr 0.9fr 1.35fr;\n    gap: 72px;\n    align-items: start;\n  }\n\n  \/* =====================================================\n     BRAND COLUMN\n  ===================================================== *\/\n\n  #theravique-footer-{{ section.id }} .tv-footer__logo {\n    margin: 0 0 17px;\n    color: var(--footer-text);\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 29px;\n    font-weight: 400;\n    line-height: 1;\n    letter-spacing: 0.045em;\n  }\n\n  #theravique-footer-{{ section.id }} .tv-footer__logo-small {\n    display: block;\n    margin-top: 9px;\n    color: var(--footer-accent);\n    font-family: Arial, sans-serif;\n    font-size: 8px;\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: 0.36em;\n  }\n\n  #theravique-footer-{{ section.id }} .tv-footer__description {\n    max-width: 355px;\n    margin: 0;\n    color: var(--footer-muted);\n    font-size: 14px;\n    line-height: 1.72;\n  }\n\n  #theravique-footer-{{ section.id }} .tv-footer__shop-link {\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    margin-top: 20px;\n    color: var(--footer-text);\n    font-size: 12px;\n    font-weight: 700;\n    line-height: 1.3;\n    letter-spacing: 0.09em;\n    text-decoration: none;\n    text-transform: uppercase;\n    transition: color 0.2s ease;\n  }\n\n  #theravique-footer-{{ section.id }} .tv-footer__shop-link::after {\n    content: \"→\";\n    color: var(--footer-accent);\n    font-size: 15px;\n    font-weight: 400;\n    transition: transform 0.2s ease;\n  }\n\n  #theravique-footer-{{ section.id }} .tv-footer__shop-link:hover {\n    color: var(--footer-accent);\n  }\n\n  #theravique-footer-{{ section.id }}\n  .tv-footer__shop-link:hover::after {\n    transform: translateX(4px);\n  }\n\n  \/* =====================================================\n     HEADINGS AND LINKS\n  ===================================================== *\/\n\n  #theravique-footer-{{ section.id }} .tv-footer__heading {\n    margin: 0 0 20px;\n    color: var(--footer-text);\n    font-size: 13px;\n    font-weight: 800;\n    line-height: 1.3;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n  }\n\n  #theravique-footer-{{ section.id }} .tv-footer__links {\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n\n  #theravique-footer-{{ section.id }} .tv-footer__links li {\n    margin: 0 0 14px;\n  }\n\n  #theravique-footer-{{ section.id }} .tv-footer__links li:last-child {\n    margin-bottom: 0;\n  }\n\n  #theravique-footer-{{ section.id }} .tv-footer__links a {\n    color: var(--footer-muted);\n    font-size: 14px;\n    line-height: 1.45;\n    text-decoration: none;\n    transition: color 0.2s ease;\n  }\n\n  #theravique-footer-{{ section.id }} .tv-footer__links a:hover {\n    color: var(--footer-accent);\n  }\n\n  \/* =====================================================\n     NEWSLETTER\n  ===================================================== *\/\n\n  #theravique-footer-{{ section.id }}\n  .tv-footer__newsletter-text {\n    max-width: 390px;\n    margin: 0 0 19px;\n    color: var(--footer-muted);\n    font-size: 14px;\n    line-height: 1.7;\n  }\n\n  #theravique-footer-{{ section.id }}\n  .tv-footer__newsletter-form {\n    display: block;\n    width: 100%;\n    max-width: 430px;\n    margin: 0;\n  }\n\n  #theravique-footer-{{ section.id }} .tv-footer__form {\n    display: flex;\n    flex-direction: column;\n    width: 100%;\n    gap: 9px;\n  }\n\n  #theravique-footer-{{ section.id }} .tv-footer__input {\n    display: block !important;\n    width: 100% !important;\n    height: 52px !important;\n    min-height: 52px !important;\n    margin: 0 !important;\n    padding: 0 16px !important;\n\n    appearance: none;\n    -webkit-appearance: none;\n\n    border: 1px solid rgba(255, 255, 255, 0.34) !important;\n    border-radius: 0 !important;\n    outline: none !important;\n    box-shadow: none !important;\n\n    background: rgba(255, 255, 255, 0.035) !important;\n    color: var(--footer-text) !important;\n\n    font-family: inherit !important;\n    font-size: 15px !important;\n    font-weight: 400 !important;\n    line-height: normal !important;\n  }\n\n  #theravique-footer-{{ section.id }}\n  .tv-footer__input::placeholder {\n    color: #a79d94 !important;\n    opacity: 1 !important;\n  }\n\n  #theravique-footer-{{ section.id }}\n  .tv-footer__input:focus {\n    border-color: var(--footer-accent) !important;\n    background: rgba(255, 255, 255, 0.055) !important;\n  }\n\n  #theravique-footer-{{ section.id }} .tv-footer__button {\n    display: flex !important;\n    width: 100% !important;\n    height: 52px !important;\n    min-height: 52px !important;\n    align-items: center;\n    justify-content: center;\n\n    margin: 0 !important;\n    padding: 0 20px !important;\n\n    appearance: none;\n    -webkit-appearance: none;\n\n    border: 1px solid var(--footer-accent) !important;\n    border-radius: 0 !important;\n    box-shadow: none !important;\n\n    background: var(--footer-accent) !important;\n    color: #22170f !important;\n\n    cursor: pointer;\n    font-family: inherit !important;\n    font-size: 12px !important;\n    font-weight: 800 !important;\n    line-height: 1 !important;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n\n    transition:\n      background 0.2s ease,\n      border-color 0.2s ease;\n  }\n\n  #theravique-footer-{{ section.id }}\n  .tv-footer__button:hover {\n    border-color: var(--footer-accent-hover) !important;\n    background: var(--footer-accent-hover) !important;\n  }\n\n  #theravique-footer-{{ section.id }} .tv-footer__message {\n    margin: 12px 0 0;\n    color: var(--footer-muted);\n    font-size: 13px;\n    line-height: 1.55;\n  }\n\n  #theravique-footer-{{ section.id }}\n  .tv-footer__message--success {\n    color: #e2c693;\n  }\n\n  \/* =====================================================\n     FOOTER BOTTOM\n  ===================================================== *\/\n\n  #theravique-footer-{{ section.id }} .tv-footer__divider {\n    width: 100%;\n    height: 1px;\n    margin: 38px 0 21px;\n    background: var(--footer-border);\n  }\n\n  #theravique-footer-{{ section.id }} .tv-footer__bottom {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 28px;\n  }\n\n  #theravique-footer-{{ section.id }} .tv-footer__legal {\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n  }\n\n  #theravique-footer-{{ section.id }}\n  .tv-footer__copyright {\n    margin: 0;\n    color: #aaa098;\n    font-size: 12px;\n    line-height: 1.5;\n  }\n\n  #theravique-footer-{{ section.id }}\n  .tv-footer__policies {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px 20px;\n  }\n\n  #theravique-footer-{{ section.id }}\n  .tv-footer__policies a {\n    color: #968d85;\n    font-size: 12px;\n    line-height: 1.5;\n    text-decoration: none;\n    transition: color 0.2s ease;\n  }\n\n  #theravique-footer-{{ section.id }}\n  .tv-footer__policies a:hover {\n    color: var(--footer-text);\n  }\n\n  #theravique-footer-{{ section.id }}\n  .tv-footer__payments {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: flex-end;\n    gap: 7px;\n  }\n\n  #theravique-footer-{{ section.id }}\n  .tv-footer__payments svg {\n    width: 36px;\n    height: auto;\n  }\n\n  \/* =====================================================\n     TABLET\n  ===================================================== *\/\n\n  @media screen and (max-width: 990px) {\n    #theravique-footer-{{ section.id }} {\n      padding-top: 44px;\n    }\n\n    #theravique-footer-{{ section.id }} .tv-footer__grid {\n      grid-template-columns: 1fr 1fr;\n      gap: 42px 55px;\n    }\n\n    #theravique-footer-{{ section.id }}\n    .tv-footer__brand-column {\n      grid-column: 1 \/ -1;\n    }\n\n    #theravique-footer-{{ section.id }}\n    .tv-footer__description {\n      max-width: 520px;\n    }\n\n    #theravique-footer-{{ section.id }}\n    .tv-footer__newsletter-form {\n      max-width: 100%;\n    }\n  }\n\n  \/* =====================================================\n     MOBILE\n  ===================================================== *\/\n\n  @media screen and (max-width: 749px) {\n    #theravique-footer-{{ section.id }} {\n      padding:\n        36px\n        20px\n        calc(26px + env(safe-area-inset-bottom));\n    }\n\n    #theravique-footer-{{ section.id }} .tv-footer__grid {\n      grid-template-columns: 1fr;\n      gap: 34px;\n    }\n\n    #theravique-footer-{{ section.id }}\n    .tv-footer__brand-column {\n      grid-column: auto;\n    }\n\n    #theravique-footer-{{ section.id }} .tv-footer__logo {\n      font-size: 26px;\n    }\n\n    #theravique-footer-{{ section.id }}\n    .tv-footer__description {\n      max-width: 100%;\n      font-size: 13px;\n      line-height: 1.7;\n    }\n\n    #theravique-footer-{{ section.id }}\n    .tv-footer__shop-link {\n      margin-top: 17px;\n    }\n\n    #theravique-footer-{{ section.id }}\n    .tv-footer__heading {\n      margin-bottom: 16px;\n    }\n\n    #theravique-footer-{{ section.id }}\n    .tv-footer__links li {\n      margin-bottom: 14px;\n    }\n\n    #theravique-footer-{{ section.id }}\n    .tv-footer__newsletter-text {\n      max-width: 100%;\n      margin-bottom: 17px;\n      font-size: 13px;\n    }\n\n    #theravique-footer-{{ section.id }}\n    .tv-footer__newsletter-form {\n      max-width: 100%;\n    }\n\n    #theravique-footer-{{ section.id }}\n    .tv-footer__input,\n    #theravique-footer-{{ section.id }}\n    .tv-footer__button {\n      height: 54px !important;\n      min-height: 54px !important;\n    }\n\n    #theravique-footer-{{ section.id }}\n    .tv-footer__divider {\n      margin: 34px 0 20px;\n    }\n\n    #theravique-footer-{{ section.id }}\n    .tv-footer__bottom {\n      flex-direction: column;\n      align-items: flex-start;\n      gap: 22px;\n    }\n\n    #theravique-footer-{{ section.id }}\n    .tv-footer__legal {\n      width: 100%;\n      gap: 15px;\n    }\n\n    #theravique-footer-{{ section.id }}\n    .tv-footer__copyright {\n      width: 100%;\n      padding-bottom: 13px;\n      border-bottom: 1px solid var(--footer-border);\n    }\n\n    #theravique-footer-{{ section.id }}\n    .tv-footer__policies {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      width: 100%;\n      gap: 13px 18px;\n    }\n\n    #theravique-footer-{{ section.id }}\n    .tv-footer__policies a {\n      display: block;\n      min-height: 20px;\n    }\n\n    #theravique-footer-{{ section.id }}\n    .tv-footer__payments {\n      justify-content: flex-start;\n    }\n  }\n\n  @media screen and (max-width: 390px) {\n    #theravique-footer-{{ section.id }} {\n      padding-right: 17px;\n      padding-left: 17px;\n    }\n\n    #theravique-footer-{{ section.id }}\n    .tv-footer__policies {\n      grid-template-columns: 1fr;\n      gap: 11px;\n    }\n  }\n<\/style>\n\n<footer\n  id=\"theravique-footer-{{ section.id }}\"\n  aria-label=\"Website footer\"\n>\n  <div class=\"tv-footer__container\">\n\n    <div class=\"tv-footer__grid\">\n\n      <!-- Brand -->\n      <div class=\"tv-footer__brand-column\">\n\n        <h2 class=\"tv-footer__logo\">\n          THERAVIQUE\n\n          <span class=\"tv-footer__logo-small\">\n            EDITIONS\n          <\/span>\n        <\/h2>\n\n        <p class=\"tv-footer__description\">\n          A home for beautiful stories and shelf-worthy editions.\n          We curate novel sets and collectible books for readers who\n          believe the experience of a story begins before the first page.\n        <\/p>\n\n        <a\n          class=\"tv-footer__shop-link\"\n          href=\"{{ routes.all_products_collection_url }}\"\n        >\n          Shop All Editions\n        <\/a>\n\n      <\/div>\n\n      <!-- Customer Care -->\n      <div class=\"tv-footer__column\">\n\n        <h3 class=\"tv-footer__heading\">\n          Customer Care\n        <\/h3>\n\n        <ul class=\"tv-footer__links\">\n\n          <li>\n            <a href=\"\/pages\/contact\">\n              Contact Us\n            <\/a>\n          <\/li>\n\n          <li>\n            <a href=\"{{ routes.root_url }}#faq\">\n              Frequently Asked Questions\n            <\/a>\n          <\/li>\n\n          <li>\n            <a href=\"\/policies\/shipping-policy\">\n              Shipping Information\n            <\/a>\n          <\/li>\n\n          <li>\n            <a href=\"\/pages\/track-order\">\n              Track Your Order\n            <\/a>\n          <\/li>\n\n        <\/ul>\n\n      <\/div>\n\n      <!-- Newsletter -->\n      <div class=\"tv-footer__newsletter-column\">\n\n        <h3 class=\"tv-footer__heading\">\n          Join the Reading List\n        <\/h3>\n\n        <p class=\"tv-footer__newsletter-text\">\n          Be the first to discover new editions, upcoming releases\n          and stories worth adding to your shelf.\n        <\/p>\n\n        {% form 'customer', class: 'tv-footer__newsletter-form' %}\n\n          <input\n            type=\"hidden\"\n            name=\"contact[tags]\"\n            value=\"newsletter\"\n          >\n\n          <div class=\"tv-footer__form\">\n\n            <input\n              class=\"tv-footer__input\"\n              type=\"email\"\n              name=\"contact[email]\"\n              value=\"{{ form.email }}\"\n              aria-label=\"Email address\"\n              placeholder=\"Enter your email address\"\n              autocomplete=\"email\"\n              autocapitalize=\"off\"\n              spellcheck=\"false\"\n              required\n            >\n\n            <button\n              class=\"tv-footer__button\"\n              type=\"submit\"\n            >\n              Join the List\n            <\/button>\n\n          <\/div>\n\n          {% if form.posted_successfully? %}\n            <p class=\"tv-footer__message tv-footer__message--success\">\n              Thank you for joining our reading list.\n            <\/p>\n          {% endif %}\n\n          {% if form.errors %}\n            <div class=\"tv-footer__message\">\n              {{ form.errors | default_errors }}\n            <\/div>\n          {% endif %}\n\n        {% endform %}\n\n      <\/div>\n\n    <\/div>\n\n    <div class=\"tv-footer__divider\"><\/div>\n\n    <div class=\"tv-footer__bottom\">\n\n      <div class=\"tv-footer__legal\">\n\n        <p class=\"tv-footer__copyright\">\n          © {{ 'now' | date: '%Y' }} Theravique Editions\n        <\/p>\n\n        <div class=\"tv-footer__policies\">\n\n          {% if shop.refund_policy != blank %}\n            <a href=\"{{ shop.refund_policy.url }}\">\n              Refund Policy\n            <\/a>\n          {% endif %}\n\n          {% if shop.privacy_policy != blank %}\n            <a href=\"{{ shop.privacy_policy.url }}\">\n              Privacy Policy\n            <\/a>\n          {% endif %}\n\n          {% if shop.terms_of_service != blank %}\n            <a href=\"{{ shop.terms_of_service.url }}\">\n              Terms of Service\n            <\/a>\n          {% endif %}\n\n          {% if shop.shipping_policy != blank %}\n            <a href=\"{{ shop.shipping_policy.url }}\">\n              Shipping Policy\n            <\/a>\n          {% endif %}\n\n        <\/div>\n\n      <\/div>\n\n      {% if shop.enabled_payment_types.size > 0 %}\n        <div\n          class=\"tv-footer__payments\"\n          aria-label=\"Accepted payment methods\"\n        >\n          {% for type in shop.enabled_payment_types %}\n            {{ type | payment_type_svg_tag }}\n          {% endfor %}\n        <\/div>\n      {% endif %}\n\n    <\/div>\n\n  <\/div>\n<\/footer>","color_scheme":"","padding_top":40,"padding_bottom":52}},"footer":{"type":"footer","blocks":{"link_list_Myq89J":{"type":"link_list","settings":{"heading":"Support","menu":"footer","width_desktop":4,"width_mobile":"2"}},"brand_information_GKeycG":{"type":"brand_information","settings":{"show_social":true,"width_desktop":4,"width_mobile":"2"}},"email_signup_k9xExW":{"type":"email_signup","settings":{"heading":"Join The Club","subtext":"<p>Get updates, deals, and a few fun surprises along the way.<\/p>","button_type":"solid","button_label":"SIGN UP","button_style_secondary":false,"width_desktop":4,"width_mobile":"2"}}},"block_order":["link_list_Myq89J","brand_information_GKeycG","email_signup_k9xExW"],"disabled":true,"settings":{"color_scheme":"accent-1","enable_follow_on_shop":false,"show_social":false,"enable_country_selector":true,"enable_language_selector":true,"payment_enable":true,"enabled_payment_types":"","show_policy":false,"branding_text":"","margin_top":0,"padding_top":32,"padding_bottom":12}}},"order":["custom_liquid_7zKimE","footer"]}