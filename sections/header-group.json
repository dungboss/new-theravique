{"name":"t:sections.header.name","type":"header","sections":{"announcement-bar":{"type":"announcement-bar","blocks":{"announcement-bar-0":{"type":"announcement","settings":{"text":"Collector Editions for Stories You’ll Never Forget","text_alignment":"center","color_scheme":"accent-1","link":""}}},"block_order":["announcement-bar-0"],"disabled":true,"settings":{}},"header":{"type":"header","disabled":true,"settings":{"sticky_header_type":"none","show_line_separator":false,"color_scheme":"background-1","logo_link":"\/","logo_position":"middle-center","menu":"main-menu","menu_type_desktop":"dropdown","highlight_active_link":true,"highlighted_link_color_scheme":"background-1","mobile_menu_title":"Menu","secondary_menu":"","menu_color_scheme":"background-1","mobile_logo_position":"center","display_search":true,"margin_bottom":0,"padding_top":8,"padding_bottom":8}},"custom_liquid_6C3twy":{"type":"custom-liquid","disabled":true,"name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<style>\n  \/* =====================================================\n     REMOVE DEFAULT CUSTOM LIQUID SPACING\n  ===================================================== *\/\n\n  #shopify-section-{{ section.id }} {\n    position: sticky;\n    top: 0;\n    z-index: 100;\n    width: 100%;\n    margin: 0 !important;\n    padding: 0 !important;\n  }\n\n  #shopify-section-{{ section.id }} > div,\n  #shopify-section-{{ section.id }} .custom-liquid,\n  #shopify-section-{{ section.id }} .page-width,\n  #shopify-section-{{ section.id }}\n  [class*=\"section-\"][class*=\"-padding\"] {\n    width: 100% !important;\n    max-width: none !important;\n    margin: 0 !important;\n    padding: 0 !important;\n  }\n\n  \/* =====================================================\n     HEADER VARIABLES\n  ===================================================== *\/\n\n  #tv-header-{{ section.id }} {\n    --announcement-bg: #17100c;\n    --header-bg: #2a1912;\n    --header-text: #f6efe7;\n    --header-muted: #c4b4a6;\n    --accent: #ddb36f;\n    --accent-hover: #ecd09f;\n    --header-border: #3d281f;\n\n    --drawer-bg: #f4ede3;\n    --drawer-text: #2a211c;\n    --drawer-muted: #74675e;\n    --drawer-border: #d9ccbc;\n\n    position: relative;\n    width: 100%;\n    font-family: inherit;\n  }\n\n  #tv-header-{{ section.id }} * {\n    box-sizing: border-box;\n  }\n\n  \/* =====================================================\n     ANNOUNCEMENT BAR\n  ===================================================== *\/\n\n  #tv-header-{{ section.id }} .tv-announcement {\n    display: flex;\n    min-height: 32px;\n    align-items: center;\n    justify-content: center;\n    padding: 7px 18px;\n\n    border-bottom: 1px solid rgba(221, 179, 111, 0.12);\n    background: var(--announcement-bg);\n    color: var(--header-text);\n\n    text-align: center;\n  }\n\n  #tv-header-{{ section.id }} .tv-announcement a {\n    color: inherit;\n    font-size: 11px;\n    font-weight: 700;\n    line-height: 1.4;\n    letter-spacing: 0.035em;\n    text-decoration: none;\n    transition: color 0.2s ease;\n  }\n\n  #tv-header-{{ section.id }} .tv-announcement a:hover {\n    color: var(--accent);\n  }\n\n  \/* =====================================================\n     MAIN HEADER\n  ===================================================== *\/\n\n  #tv-header-{{ section.id }} .tv-header {\n    position: relative;\n\n    border-bottom: 1px solid var(--header-border);\n    background: var(--header-bg);\n\n    box-shadow: 0 2px 8px rgba(20, 12, 8, 0.12);\n  }\n\n  #tv-header-{{ section.id }} .tv-header__inner {\n    display: grid;\n    grid-template-columns: 1fr auto 1fr;\n\n    width: 100%;\n    max-width: 1240px;\n    min-height: 70px;\n\n    align-items: center;\n    margin: 0 auto;\n    padding: 0 28px;\n\n    background: transparent;\n  }\n\n  \/* =====================================================\n     DESKTOP NAVIGATION\n  ===================================================== *\/\n\n  #tv-header-{{ section.id }} .tv-header__nav {\n    display: flex;\n    align-items: center;\n    gap: 32px;\n    justify-self: start;\n  }\n\n  #tv-header-{{ section.id }} .tv-header__nav a {\n    position: relative;\n\n    color: var(--header-text);\n    font-size: 13px;\n    font-weight: 500;\n    line-height: 1;\n    letter-spacing: 0.02em;\n\n    text-decoration: none;\n    white-space: nowrap;\n\n    transition: color 0.2s ease;\n  }\n\n  #tv-header-{{ section.id }} .tv-header__nav a::after {\n    content: \"\";\n    position: absolute;\n    right: 0;\n    bottom: -9px;\n    left: 0;\n\n    height: 1px;\n    background: var(--accent);\n\n    transform: scaleX(0);\n    transform-origin: center;\n    transition: transform 0.2s ease;\n  }\n\n  #tv-header-{{ section.id }} .tv-header__nav a:hover {\n    color: var(--accent);\n  }\n\n  #tv-header-{{ section.id }} .tv-header__nav a:hover::after {\n    transform: scaleX(1);\n  }\n\n  \/* =====================================================\n     BRAND\n  ===================================================== *\/\n\n  #tv-header-{{ section.id }} .tv-header__brand {\n    display: inline-flex;\n    flex-direction: column;\n    align-items: center;\n    justify-self: center;\n\n    color: var(--header-text);\n    text-decoration: none;\n  }\n\n  #tv-header-{{ section.id }} .tv-header__brand-name {\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 25px;\n    font-weight: 400;\n    line-height: 0.95;\n    letter-spacing: 0.065em;\n  }\n\n  #tv-header-{{ section.id }} .tv-header__brand-small {\n    margin-top: 7px;\n\n    color: var(--accent);\n\n    font-family: Arial, sans-serif;\n    font-size: 7px;\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: 0.36em;\n  }\n\n  \/* =====================================================\n     HEADER ACTIONS\n  ===================================================== *\/\n\n  #tv-header-{{ section.id }} .tv-header__actions {\n    display: flex;\n    align-items: center;\n    justify-content: flex-end;\n    gap: 14px;\n    justify-self: end;\n  }\n\n  #tv-header-{{ section.id }} .tv-header__icon {\n    position: relative;\n\n    display: inline-flex;\n    width: 36px;\n    height: 36px;\n\n    align-items: center;\n    justify-content: center;\n\n    padding: 0;\n    border: 0;\n    background: transparent;\n\n    color: var(--header-text);\n    cursor: pointer;\n    text-decoration: none;\n\n    transition:\n      color 0.2s ease,\n      transform 0.2s ease;\n  }\n\n  #tv-header-{{ section.id }} .tv-header__icon svg {\n    width: 21px;\n    height: 21px;\n\n    fill: none;\n    stroke: currentColor;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n    stroke-width: 1.6;\n  }\n\n  #tv-header-{{ section.id }} .tv-header__icon:hover {\n    color: var(--accent);\n    transform: translateY(-1px);\n  }\n\n  #tv-header-{{ section.id }} .tv-cart-count {\n    position: absolute;\n    top: 0;\n    right: -1px;\n\n    display: flex;\n    min-width: 17px;\n    height: 17px;\n\n    align-items: center;\n    justify-content: center;\n\n    padding: 0 4px;\n\n    border: 2px solid var(--header-bg);\n    border-radius: 999px;\n\n    background: var(--accent);\n    color: #22170f;\n\n    font-size: 9px;\n    font-weight: 800;\n    line-height: 1;\n  }\n\n  \/* =====================================================\n     MOBILE MENU BUTTON\n  ===================================================== *\/\n\n  #tv-header-{{ section.id }} .tv-menu-button {\n    display: none;\n  }\n\n  \/* =====================================================\n     MOBILE DRAWER\n  ===================================================== *\/\n\n  #tv-header-{{ section.id }} .tv-drawer-overlay {\n    position: fixed;\n    z-index: 101;\n    inset: 0;\n\n    visibility: hidden;\n\n    background: rgba(16, 9, 6, 0.62);\n    opacity: 0;\n\n    transition:\n      opacity 0.25s ease,\n      visibility 0.25s ease;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer {\n    position: fixed;\n    z-index: 102;\n    top: 0;\n    bottom: 0;\n    left: 0;\n\n    width: min(86vw, 360px);\n    overflow-y: auto;\n\n    background: var(--drawer-bg);\n    color: var(--drawer-text);\n\n    box-shadow: 12px 0 38px rgba(0, 0, 0, 0.25);\n\n    transform: translateX(-105%);\n    transition: transform 0.28s ease;\n  }\n\n  #tv-header-{{ section.id }}.is-menu-open .tv-drawer-overlay {\n    visibility: visible;\n    opacity: 1;\n  }\n\n  #tv-header-{{ section.id }}.is-menu-open .tv-drawer {\n    transform: translateX(0);\n  }\n\n  \/* Drawer header *\/\n\n  #tv-header-{{ section.id }} .tv-drawer__top {\n    display: flex;\n    min-height: 72px;\n\n    align-items: center;\n    justify-content: space-between;\n\n    padding: 0 22px;\n\n    border-bottom: 1px solid var(--drawer-border);\n    background: #eadfce;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__brand {\n    display: flex;\n    flex-direction: column;\n    color: var(--drawer-text);\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__title {\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 21px;\n    line-height: 1;\n    letter-spacing: 0.06em;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__title-small {\n    margin-top: 6px;\n    color: #a17642;\n    font-family: Arial, sans-serif;\n    font-size: 7px;\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: 0.3em;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__close {\n    display: flex;\n    width: 38px;\n    height: 38px;\n\n    align-items: center;\n    justify-content: center;\n\n    padding: 0;\n    border: 0;\n    background: transparent;\n\n    color: var(--drawer-text);\n    cursor: pointer;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__close svg {\n    width: 23px;\n    height: 23px;\n\n    fill: none;\n    stroke: currentColor;\n    stroke-linecap: round;\n    stroke-width: 1.6;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__content {\n    padding: 24px 22px 40px;\n  }\n\n  \/* Drawer search *\/\n\n  #tv-header-{{ section.id }} .tv-drawer__search {\n    display: flex;\n    width: 100%;\n    height: 50px;\n\n    margin-bottom: 28px;\n\n    border: 1px solid var(--drawer-border);\n    background: #fffaf2;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__search input {\n    flex: 1;\n    min-width: 0;\n    height: 100%;\n\n    padding: 0 14px;\n\n    border: 0;\n    outline: 0;\n    background: transparent;\n\n    color: var(--drawer-text);\n\n    font-family: inherit;\n    font-size: 16px;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__search input::placeholder {\n    color: #94877c;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__search button {\n    display: flex;\n    width: 50px;\n\n    align-items: center;\n    justify-content: center;\n\n    padding: 0;\n    border: 0;\n\n    background: var(--header-bg);\n    color: var(--header-text);\n\n    cursor: pointer;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__search button:hover {\n    background: #3a251c;\n    color: var(--accent);\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__search svg {\n    width: 19px;\n    height: 19px;\n\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 1.7;\n  }\n\n  \/* Drawer links *\/\n\n  #tv-header-{{ section.id }} .tv-drawer__links {\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__links li {\n    border-bottom: 1px solid var(--drawer-border);\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__links a {\n    display: flex;\n    min-height: 56px;\n\n    align-items: center;\n    justify-content: space-between;\n\n    color: var(--drawer-text);\n\n    font-size: 15px;\n    font-weight: 600;\n    text-decoration: none;\n\n    transition:\n      color 0.2s ease,\n      padding-left 0.2s ease;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__links a::after {\n    content: \"→\";\n\n    color: #9b8064;\n    font-size: 16px;\n    font-weight: 400;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__links a:hover {\n    padding-left: 4px;\n    color: #8a6234;\n  }\n\n  \/* Drawer account *\/\n\n  #tv-header-{{ section.id }} .tv-drawer__account {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n\n    margin-top: 28px;\n\n    color: var(--drawer-muted);\n\n    font-size: 14px;\n    text-decoration: none;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__account svg {\n    width: 20px;\n    height: 20px;\n\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 1.6;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__account:hover {\n    color: #8a6234;\n  }\n\n  \/* =====================================================\n     TABLET\n  ===================================================== *\/\n\n  @media screen and (max-width: 990px) {\n    #tv-header-{{ section.id }} .tv-header__inner {\n      padding-right: 20px;\n      padding-left: 20px;\n    }\n\n    #tv-header-{{ section.id }} .tv-header__nav {\n      gap: 22px;\n    }\n  }\n\n  \/* =====================================================\n     MOBILE\n  ===================================================== *\/\n\n  @media screen and (max-width: 749px) {\n    #tv-header-{{ section.id }} .tv-announcement {\n      min-height: 30px;\n      padding: 6px 12px;\n    }\n\n    #tv-header-{{ section.id }} .tv-announcement a {\n      font-size: 9px;\n      letter-spacing: 0.025em;\n    }\n\n    #tv-header-{{ section.id }} .tv-header__inner {\n      grid-template-columns: 76px 1fr 76px;\n\n      min-height: 60px;\n      padding: 0 10px;\n\n      background: transparent;\n    }\n\n    #tv-header-{{ section.id }} .tv-header__nav {\n      display: none;\n    }\n\n    #tv-header-{{ section.id }} .tv-menu-button {\n      display: inline-flex;\n      justify-self: start;\n    }\n\n    #tv-header-{{ section.id }} .tv-header__brand-name {\n      font-size: 20px;\n      letter-spacing: 0.045em;\n    }\n\n    #tv-header-{{ section.id }} .tv-header__brand-small {\n      margin-top: 5px;\n      font-size: 6px;\n      letter-spacing: 0.34em;\n    }\n\n    #tv-header-{{ section.id }} .tv-header__actions {\n      gap: 1px;\n    }\n\n    #tv-header-{{ section.id }} .tv-header__account {\n      display: none;\n    }\n\n    #tv-header-{{ section.id }} .tv-header__icon {\n      width: 36px;\n      height: 36px;\n    }\n\n    #tv-header-{{ section.id }} .tv-header__icon svg {\n      width: 20px;\n      height: 20px;\n    }\n  }\n<\/style>\n\n<header id=\"tv-header-{{ section.id }}\">\n\n  <!-- Announcement bar -->\n  <div class=\"tv-announcement\">\n    <a href=\"{{ routes.all_products_collection_url }}\">\n      Collector Editions for Stories You’ll Never Forget\n    <\/a>\n  <\/div>\n\n  <!-- Main header -->\n  <div class=\"tv-header\">\n    <div class=\"tv-header__inner\">\n\n      <!-- Desktop navigation -->\n      <nav\n        class=\"tv-header__nav\"\n        aria-label=\"Main navigation\"\n      >\n        <a href=\"{{ routes.root_url }}\">\n          Home\n        <\/a>\n\n        <a href=\"{{ routes.all_products_collection_url }}\">\n          Shop All\n        <\/a>\n\n        <a href=\"\/pages\/contact\">\n          Contact\n        <\/a>\n      <\/nav>\n\n      <!-- Mobile menu button -->\n      <button\n        class=\"tv-header__icon tv-menu-button\"\n        type=\"button\"\n        aria-label=\"Open menu\"\n        aria-expanded=\"false\"\n        data-tv-menu-open\n      >\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n          <path d=\"M4 7h16\"><\/path>\n          <path d=\"M4 12h16\"><\/path>\n          <path d=\"M4 17h16\"><\/path>\n        <\/svg>\n      <\/button>\n\n      <!-- Brand -->\n      <a\n        class=\"tv-header__brand\"\n        href=\"{{ routes.root_url }}\"\n        aria-label=\"Theravique Editions home\"\n      >\n        <span class=\"tv-header__brand-name\">\n          THERAVIQUE\n        <\/span>\n\n        <span class=\"tv-header__brand-small\">\n          EDITIONS\n        <\/span>\n      <\/a>\n\n      <!-- Header actions -->\n      <div class=\"tv-header__actions\">\n\n        <a\n          class=\"tv-header__icon\"\n          href=\"{{ routes.search_url }}\"\n          aria-label=\"Search\"\n        >\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n            <circle cx=\"11\" cy=\"11\" r=\"6.5\"><\/circle>\n            <path d=\"m16 16 4 4\"><\/path>\n          <\/svg>\n        <\/a>\n\n        <a\n          class=\"tv-header__icon tv-header__account\"\n          href=\"{{ routes.account_url }}\"\n          aria-label=\"Account\"\n        >\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n            <circle cx=\"12\" cy=\"8\" r=\"3.2\"><\/circle>\n            <path d=\"M5.5 20c.7-4 3-6 6.5-6s5.8 2 6.5 6\"><\/path>\n          <\/svg>\n        <\/a>\n\n        <a\n          class=\"tv-header__icon\"\n          href=\"{{ routes.cart_url }}\"\n          aria-label=\"Cart\"\n        >\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M6.5 8.5h11l1 11h-13z\"><\/path>\n            <path d=\"M9 9V6.5a3 3 0 0 1 6 0V9\"><\/path>\n          <\/svg>\n\n          {% if cart.item_count > 0 %}\n            <span class=\"tv-cart-count\">\n              {{ cart.item_count }}\n            <\/span>\n          {% endif %}\n        <\/a>\n\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <!-- Mobile overlay -->\n  <div\n    class=\"tv-drawer-overlay\"\n    data-tv-menu-close\n  ><\/div>\n\n  <!-- Mobile drawer -->\n  <aside\n    class=\"tv-drawer\"\n    aria-label=\"Mobile navigation\"\n    aria-hidden=\"true\"\n  >\n\n    <div class=\"tv-drawer__top\">\n\n      <div class=\"tv-drawer__brand\">\n        <span class=\"tv-drawer__title\">\n          THERAVIQUE\n        <\/span>\n\n        <span class=\"tv-drawer__title-small\">\n          EDITIONS\n        <\/span>\n      <\/div>\n\n      <button\n        class=\"tv-drawer__close\"\n        type=\"button\"\n        aria-label=\"Close menu\"\n        data-tv-menu-close\n      >\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n          <path d=\"M5 5l14 14\"><\/path>\n          <path d=\"M19 5 5 19\"><\/path>\n        <\/svg>\n      <\/button>\n\n    <\/div>\n\n    <div class=\"tv-drawer__content\">\n\n      <!-- Mobile search -->\n      <form\n        class=\"tv-drawer__search\"\n        action=\"{{ routes.search_url }}\"\n        method=\"get\"\n        role=\"search\"\n      >\n        <input\n          type=\"search\"\n          name=\"q\"\n          placeholder=\"Search by title or series\"\n          aria-label=\"Search\"\n        >\n\n        <button\n          type=\"submit\"\n          aria-label=\"Submit search\"\n        >\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n            <circle cx=\"11\" cy=\"11\" r=\"6.5\"><\/circle>\n            <path d=\"m16 16 4 4\"><\/path>\n          <\/svg>\n        <\/button>\n      <\/form>\n\n      <!-- Mobile links -->\n      <ul class=\"tv-drawer__links\">\n\n        <li>\n          <a href=\"{{ routes.root_url }}\">\n            Home\n          <\/a>\n        <\/li>\n\n        <li>\n          <a href=\"{{ routes.all_products_collection_url }}\">\n            Shop All\n          <\/a>\n        <\/li>\n\n        <li>\n          <a href=\"\/pages\/contact\">\n            Contact Us\n          <\/a>\n        <\/li>\n\n      <\/ul>\n\n      <!-- Mobile account -->\n      <a\n        class=\"tv-drawer__account\"\n        href=\"{{ routes.account_url }}\"\n      >\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n          <circle cx=\"12\" cy=\"8\" r=\"3.2\"><\/circle>\n          <path d=\"M5.5 20c.7-4 3-6 6.5-6s5.8 2 6.5 6\"><\/path>\n        <\/svg>\n\n        Account & Order History\n      <\/a>\n\n    <\/div>\n  <\/aside>\n\n<\/header>\n\n<script>\n  (() => {\n    const header = document.getElementById(\n      'tv-header-{{ section.id }}'\n    );\n\n    if (!header || header.dataset.initialized === 'true') {\n      return;\n    }\n\n    header.dataset.initialized = 'true';\n\n    const openButton =\n      header.querySelector('[data-tv-menu-open]');\n\n    const closeButtons =\n      header.querySelectorAll('[data-tv-menu-close]');\n\n    const drawer =\n      header.querySelector('.tv-drawer');\n\n    const openMenu = () => {\n      header.classList.add('is-menu-open');\n\n      openButton?.setAttribute(\n        'aria-expanded',\n        'true'\n      );\n\n      drawer?.setAttribute(\n        'aria-hidden',\n        'false'\n      );\n\n      document.documentElement.style.overflow =\n        'hidden';\n    };\n\n    const closeMenu = () => {\n      header.classList.remove('is-menu-open');\n\n      openButton?.setAttribute(\n        'aria-expanded',\n        'false'\n      );\n\n      drawer?.setAttribute(\n        'aria-hidden',\n        'true'\n      );\n\n      document.documentElement.style.overflow =\n        '';\n    };\n\n    openButton?.addEventListener(\n      'click',\n      openMenu\n    );\n\n    closeButtons.forEach((button) => {\n      button.addEventListener(\n        'click',\n        closeMenu\n      );\n    });\n\n    document.addEventListener(\n      'keydown',\n      (event) => {\n        if (event.key === 'Escape') {\n          closeMenu();\n        }\n      }\n    );\n\n    window.addEventListener(\n      'resize',\n      () => {\n        if (window.innerWidth > 749) {\n          closeMenu();\n        }\n      }\n    );\n  })();\n<\/script>","color_scheme":"","padding_top":40,"padding_bottom":52}},"custom_liquid_B7XHEh":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<style>\n  \/* =====================================================\n     REMOVE DEFAULT CUSTOM LIQUID SPACING\n  ===================================================== *\/\n\n  #shopify-section-{{ section.id }} {\n    position: sticky;\n    top: 0;\n    z-index: 100;\n    width: 100%;\n    margin: 0 !important;\n    padding: 0 !important;\n  }\n\n  #shopify-section-{{ section.id }} > div,\n  #shopify-section-{{ section.id }} .custom-liquid,\n  #shopify-section-{{ section.id }} .page-width,\n  #shopify-section-{{ section.id }}\n  [class*=\"section-\"][class*=\"-padding\"] {\n    width: 100% !important;\n    max-width: none !important;\n    margin: 0 !important;\n    padding: 0 !important;\n  }\n\n  \/* =====================================================\n     HEADER VARIABLES\n  ===================================================== *\/\n\n  #tv-header-{{ section.id }} {\n    --announcement-bg: #17100c;\n    --header-bg: #2a1912;\n    --header-text: #f6efe7;\n    --header-muted: #c4b4a6;\n    --accent: #ddb36f;\n    --accent-hover: #ecd09f;\n    --header-border: #3d281f;\n\n    --drawer-bg: #f4ede3;\n    --drawer-text: #2a211c;\n    --drawer-muted: #74675e;\n    --drawer-border: #d9ccbc;\n\n    position: relative;\n    width: 100%;\n    font-family: inherit;\n  }\n\n  #tv-header-{{ section.id }} * {\n    box-sizing: border-box;\n  }\n\n  \/* =====================================================\n     ANNOUNCEMENT BAR\n  ===================================================== *\/\n\n  #tv-header-{{ section.id }} .tv-announcement {\n    display: flex;\n    min-height: 32px;\n    align-items: center;\n    justify-content: center;\n    padding: 7px 18px;\n\n    border-bottom: 1px solid rgba(221, 179, 111, 0.12);\n    background: var(--announcement-bg);\n    color: var(--header-text);\n\n    text-align: center;\n  }\n\n  #tv-header-{{ section.id }} .tv-announcement a {\n    color: inherit;\n    font-size: 11px;\n    font-weight: 700;\n    line-height: 1.4;\n    letter-spacing: 0.035em;\n    text-decoration: none;\n    transition: color 0.2s ease;\n  }\n\n  #tv-header-{{ section.id }} .tv-announcement a:hover {\n    color: var(--accent);\n  }\n\n  \/* =====================================================\n     MAIN HEADER\n  ===================================================== *\/\n\n  #tv-header-{{ section.id }} .tv-header {\n    position: relative;\n\n    border-bottom: 1px solid var(--header-border);\n    background: var(--header-bg);\n\n    box-shadow: 0 2px 8px rgba(20, 12, 8, 0.12);\n  }\n\n  #tv-header-{{ section.id }} .tv-header__inner {\n    display: grid;\n    grid-template-columns: 1fr auto 1fr;\n\n    width: 100%;\n    max-width: 1240px;\n    min-height: 70px;\n\n    align-items: center;\n    margin: 0 auto;\n    padding: 0 28px;\n\n    background: transparent;\n  }\n\n  \/* =====================================================\n     DESKTOP NAVIGATION\n  ===================================================== *\/\n\n  #tv-header-{{ section.id }} .tv-header__nav {\n    display: flex;\n    align-items: center;\n    gap: 32px;\n    justify-self: start;\n  }\n\n  #tv-header-{{ section.id }} .tv-header__nav a {\n    position: relative;\n\n    color: var(--header-text);\n    font-size: 13px;\n    font-weight: 500;\n    line-height: 1;\n    letter-spacing: 0.02em;\n\n    text-decoration: none;\n    white-space: nowrap;\n\n    transition: color 0.2s ease;\n  }\n\n  #tv-header-{{ section.id }} .tv-header__nav a::after {\n    content: \"\";\n    position: absolute;\n    right: 0;\n    bottom: -9px;\n    left: 0;\n\n    height: 1px;\n    background: var(--accent);\n\n    transform: scaleX(0);\n    transform-origin: center;\n    transition: transform 0.2s ease;\n  }\n\n  #tv-header-{{ section.id }} .tv-header__nav a:hover {\n    color: var(--accent);\n  }\n\n  #tv-header-{{ section.id }} .tv-header__nav a:hover::after {\n    transform: scaleX(1);\n  }\n\n  \/* =====================================================\n     BRAND\n  ===================================================== *\/\n\n  #tv-header-{{ section.id }} .tv-header__brand {\n    display: inline-flex;\n    flex-direction: column;\n    align-items: center;\n    justify-self: center;\n\n    color: var(--header-text);\n    text-decoration: none;\n  }\n\n  #tv-header-{{ section.id }} .tv-header__brand-name {\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 25px;\n    font-weight: 400;\n    line-height: 0.95;\n    letter-spacing: 0.065em;\n  }\n\n  #tv-header-{{ section.id }} .tv-header__brand-small {\n    margin-top: 7px;\n\n    color: var(--accent);\n\n    font-family: Arial, sans-serif;\n    font-size: 7px;\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: 0.36em;\n  }\n\n  \/* =====================================================\n     HEADER ACTIONS\n  ===================================================== *\/\n\n  #tv-header-{{ section.id }} .tv-header__actions {\n    display: flex;\n    align-items: center;\n    justify-content: flex-end;\n    gap: 14px;\n    justify-self: end;\n  }\n\n  #tv-header-{{ section.id }} .tv-header__icon {\n    position: relative;\n\n    display: inline-flex;\n    width: 36px;\n    height: 36px;\n\n    align-items: center;\n    justify-content: center;\n\n    padding: 0;\n    border: 0;\n    background: transparent;\n\n    color: var(--header-text);\n    cursor: pointer;\n    text-decoration: none;\n\n    transition:\n      color 0.2s ease,\n      transform 0.2s ease;\n  }\n\n  #tv-header-{{ section.id }} .tv-header__icon svg {\n    width: 21px;\n    height: 21px;\n\n    fill: none;\n    stroke: currentColor;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n    stroke-width: 1.6;\n  }\n\n  #tv-header-{{ section.id }} .tv-header__icon:hover {\n    color: var(--accent);\n    transform: translateY(-1px);\n  }\n\n  #tv-header-{{ section.id }} .tv-cart-count {\n    position: absolute;\n    top: 0;\n    right: -1px;\n\n    display: flex;\n    min-width: 17px;\n    height: 17px;\n\n    align-items: center;\n    justify-content: center;\n\n    padding: 0 4px;\n\n    border: 2px solid var(--header-bg);\n    border-radius: 999px;\n\n    background: var(--accent);\n    color: #22170f;\n\n    font-size: 9px;\n    font-weight: 800;\n    line-height: 1;\n  }\n\n  \/* Badge co display:flex nen attribute hidden mac dinh\n     khong an duoc → phai ep display:none o day *\/\n  #tv-header-{{ section.id }} .tv-cart-count[hidden] {\n    display: none !important;\n  }\n\n  \/* =====================================================\n     MOBILE MENU BUTTON\n  ===================================================== *\/\n\n  #tv-header-{{ section.id }} .tv-menu-button {\n    display: none;\n  }\n\n  \/* =====================================================\n     MOBILE DRAWER\n  ===================================================== *\/\n\n  #tv-header-{{ section.id }} .tv-drawer-overlay {\n    position: fixed;\n    z-index: 101;\n    inset: 0;\n\n    visibility: hidden;\n\n    background: rgba(16, 9, 6, 0.62);\n    opacity: 0;\n\n    transition:\n      opacity 0.25s ease,\n      visibility 0.25s ease;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer {\n    position: fixed;\n    z-index: 102;\n    top: 0;\n    bottom: 0;\n    left: 0;\n\n    width: min(86vw, 360px);\n    overflow-y: auto;\n\n    background: var(--drawer-bg);\n    color: var(--drawer-text);\n\n    box-shadow: 12px 0 38px rgba(0, 0, 0, 0.25);\n\n    transform: translateX(-105%);\n    transition: transform 0.28s ease;\n  }\n\n  #tv-header-{{ section.id }}.is-menu-open .tv-drawer-overlay {\n    visibility: visible;\n    opacity: 1;\n  }\n\n  #tv-header-{{ section.id }}.is-menu-open .tv-drawer {\n    transform: translateX(0);\n  }\n\n  \/* Drawer header *\/\n\n  #tv-header-{{ section.id }} .tv-drawer__top {\n    display: flex;\n    min-height: 72px;\n\n    align-items: center;\n    justify-content: space-between;\n\n    padding: 0 22px;\n\n    border-bottom: 1px solid var(--drawer-border);\n    background: #eadfce;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__brand {\n    display: flex;\n    flex-direction: column;\n    color: var(--drawer-text);\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__title {\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 21px;\n    line-height: 1;\n    letter-spacing: 0.06em;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__title-small {\n    margin-top: 6px;\n    color: #a17642;\n    font-family: Arial, sans-serif;\n    font-size: 7px;\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: 0.3em;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__close {\n    display: flex;\n    width: 38px;\n    height: 38px;\n\n    align-items: center;\n    justify-content: center;\n\n    padding: 0;\n    border: 0;\n    background: transparent;\n\n    color: var(--drawer-text);\n    cursor: pointer;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__close svg {\n    width: 23px;\n    height: 23px;\n\n    fill: none;\n    stroke: currentColor;\n    stroke-linecap: round;\n    stroke-width: 1.6;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__content {\n    padding: 24px 22px 40px;\n  }\n\n  \/* Drawer search *\/\n\n  #tv-header-{{ section.id }} .tv-drawer__search {\n    display: flex;\n    width: 100%;\n    height: 50px;\n\n    margin-bottom: 28px;\n\n    border: 1px solid var(--drawer-border);\n    background: #fffaf2;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__search input {\n    flex: 1;\n    min-width: 0;\n    height: 100%;\n\n    padding: 0 14px;\n\n    border: 0;\n    outline: 0;\n    background: transparent;\n\n    color: var(--drawer-text);\n\n    font-family: inherit;\n    font-size: 16px;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__search input::placeholder {\n    color: #94877c;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__search button {\n    display: flex;\n    width: 50px;\n\n    align-items: center;\n    justify-content: center;\n\n    padding: 0;\n    border: 0;\n\n    background: var(--header-bg);\n    color: var(--header-text);\n\n    cursor: pointer;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__search button:hover {\n    background: #3a251c;\n    color: var(--accent);\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__search svg {\n    width: 19px;\n    height: 19px;\n\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 1.7;\n  }\n\n  \/* Drawer links *\/\n\n  #tv-header-{{ section.id }} .tv-drawer__links {\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__links li {\n    border-bottom: 1px solid var(--drawer-border);\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__links a {\n    display: flex;\n    min-height: 56px;\n\n    align-items: center;\n    justify-content: space-between;\n\n    color: var(--drawer-text);\n\n    font-size: 15px;\n    font-weight: 600;\n    text-decoration: none;\n\n    transition:\n      color 0.2s ease,\n      padding-left 0.2s ease;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__links a::after {\n    content: \"→\";\n\n    color: #9b8064;\n    font-size: 16px;\n    font-weight: 400;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__links a:hover {\n    padding-left: 4px;\n    color: #8a6234;\n  }\n\n  \/* Drawer account *\/\n\n  #tv-header-{{ section.id }} .tv-drawer__account {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n\n    margin-top: 28px;\n\n    color: var(--drawer-muted);\n\n    font-size: 14px;\n    text-decoration: none;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__account svg {\n    width: 20px;\n    height: 20px;\n\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 1.6;\n  }\n\n  #tv-header-{{ section.id }} .tv-drawer__account:hover {\n    color: #8a6234;\n  }\n\n  \/* =====================================================\n     TABLET\n  ===================================================== *\/\n\n  @media screen and (max-width: 990px) {\n    #tv-header-{{ section.id }} .tv-header__inner {\n      padding-right: 20px;\n      padding-left: 20px;\n    }\n\n    #tv-header-{{ section.id }} .tv-header__nav {\n      gap: 22px;\n    }\n  }\n\n  \/* =====================================================\n     MOBILE\n  ===================================================== *\/\n\n  @media screen and (max-width: 749px) {\n    #tv-header-{{ section.id }} .tv-announcement {\n      min-height: 30px;\n      padding: 6px 12px;\n    }\n\n    #tv-header-{{ section.id }} .tv-announcement a {\n      font-size: 9px;\n      letter-spacing: 0.025em;\n    }\n\n    #tv-header-{{ section.id }} .tv-header__inner {\n      grid-template-columns: 76px 1fr 76px;\n\n      min-height: 60px;\n      padding: 0 10px;\n\n      background: transparent;\n    }\n\n    #tv-header-{{ section.id }} .tv-header__nav {\n      display: none;\n    }\n\n    #tv-header-{{ section.id }} .tv-menu-button {\n      display: inline-flex;\n      justify-self: start;\n    }\n\n    #tv-header-{{ section.id }} .tv-header__brand-name {\n      font-size: 20px;\n      letter-spacing: 0.045em;\n    }\n\n    #tv-header-{{ section.id }} .tv-header__brand-small {\n      margin-top: 5px;\n      font-size: 6px;\n      letter-spacing: 0.34em;\n    }\n\n    #tv-header-{{ section.id }} .tv-header__actions {\n      gap: 1px;\n    }\n\n    #tv-header-{{ section.id }} .tv-header__account {\n      display: none;\n    }\n\n    #tv-header-{{ section.id }} .tv-header__icon {\n      width: 36px;\n      height: 36px;\n    }\n\n    #tv-header-{{ section.id }} .tv-header__icon svg {\n      width: 20px;\n      height: 20px;\n    }\n  }\n<\/style>\n\n<header id=\"tv-header-{{ section.id }}\">\n\n  <!-- Announcement bar -->\n  <div class=\"tv-announcement\">\n    <a href=\"{{ routes.all_products_collection_url }}\">\n      Collector Editions for Stories You’ll Never Forget\n    <\/a>\n  <\/div>\n\n  <!-- Main header -->\n  <div class=\"tv-header\">\n    <div class=\"tv-header__inner\">\n\n      <!-- Desktop navigation -->\n      <nav\n        class=\"tv-header__nav\"\n        aria-label=\"Main navigation\"\n      >\n        <a href=\"{{ routes.root_url }}\">\n          Home\n        <\/a>\n\n        <a href=\"{{ routes.all_products_collection_url }}\">\n          Shop All\n        <\/a>\n\n        <a href=\"\/pages\/contact\">\n          Contact\n        <\/a>\n      <\/nav>\n\n      <!-- Mobile menu button -->\n      <button\n        class=\"tv-header__icon tv-menu-button\"\n        type=\"button\"\n        aria-label=\"Open menu\"\n        aria-expanded=\"false\"\n        data-tv-menu-open\n      >\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n          <path d=\"M4 7h16\"><\/path>\n          <path d=\"M4 12h16\"><\/path>\n          <path d=\"M4 17h16\"><\/path>\n        <\/svg>\n      <\/button>\n\n      <!-- Brand -->\n      <a\n        class=\"tv-header__brand\"\n        href=\"{{ routes.root_url }}\"\n        aria-label=\"Theravique Editions home\"\n      >\n        <span class=\"tv-header__brand-name\">\n          THERAVIQUE\n        <\/span>\n\n        <span class=\"tv-header__brand-small\">\n          EDITIONS\n        <\/span>\n      <\/a>\n\n      <!-- Header actions -->\n      <div class=\"tv-header__actions\">\n\n        <a\n          class=\"tv-header__icon\"\n          href=\"{{ routes.search_url }}\"\n          aria-label=\"Search\"\n        >\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n            <circle cx=\"11\" cy=\"11\" r=\"6.5\"><\/circle>\n            <path d=\"m16 16 4 4\"><\/path>\n          <\/svg>\n        <\/a>\n\n        <a\n          class=\"tv-header__icon tv-header__account\"\n          href=\"{{ routes.account_url }}\"\n          aria-label=\"Account\"\n        >\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n            <circle cx=\"12\" cy=\"8\" r=\"3.2\"><\/circle>\n            <path d=\"M5.5 20c.7-4 3-6 6.5-6s5.8 2 6.5 6\"><\/path>\n          <\/svg>\n        <\/a>\n\n        <!-- Cart: click mo cart drawer cua theme, khong co drawer thi ve \/cart -->\n        <a\n          class=\"tv-header__icon\"\n          href=\"{{ routes.cart_url }}\"\n          aria-label=\"Cart\"\n          data-tv-cart-open\n        >\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M6.5 8.5h11l1 11h-13z\"><\/path>\n            <path d=\"M9 9V6.5a3 3 0 0 1 6 0V9\"><\/path>\n          <\/svg>\n\n          <span\n            class=\"tv-cart-count\"\n            data-tv-cart-count\n            {% if cart.item_count == 0 %}hidden{% endif %}\n          >\n            {{ cart.item_count }}\n          <\/span>\n        <\/a>\n\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <!-- Mobile overlay -->\n  <div\n    class=\"tv-drawer-overlay\"\n    data-tv-menu-close\n  ><\/div>\n\n  <!-- Mobile drawer -->\n  <aside\n    class=\"tv-drawer\"\n    aria-label=\"Mobile navigation\"\n    aria-hidden=\"true\"\n  >\n\n    <div class=\"tv-drawer__top\">\n\n      <div class=\"tv-drawer__brand\">\n        <span class=\"tv-drawer__title\">\n          THERAVIQUE\n        <\/span>\n\n        <span class=\"tv-drawer__title-small\">\n          EDITIONS\n        <\/span>\n      <\/div>\n\n      <button\n        class=\"tv-drawer__close\"\n        type=\"button\"\n        aria-label=\"Close menu\"\n        data-tv-menu-close\n      >\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n          <path d=\"M5 5l14 14\"><\/path>\n          <path d=\"M19 5 5 19\"><\/path>\n        <\/svg>\n      <\/button>\n\n    <\/div>\n\n    <div class=\"tv-drawer__content\">\n\n      <!-- Mobile search -->\n      <form\n        class=\"tv-drawer__search\"\n        action=\"{{ routes.search_url }}\"\n        method=\"get\"\n        role=\"search\"\n      >\n        <input\n          type=\"search\"\n          name=\"q\"\n          placeholder=\"Search by title or series\"\n          aria-label=\"Search\"\n        >\n\n        <button\n          type=\"submit\"\n          aria-label=\"Submit search\"\n        >\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n            <circle cx=\"11\" cy=\"11\" r=\"6.5\"><\/circle>\n            <path d=\"m16 16 4 4\"><\/path>\n          <\/svg>\n        <\/button>\n      <\/form>\n\n      <!-- Mobile links -->\n      <ul class=\"tv-drawer__links\">\n\n        <li>\n          <a href=\"{{ routes.root_url }}\">\n            Home\n          <\/a>\n        <\/li>\n\n        <li>\n          <a href=\"{{ routes.all_products_collection_url }}\">\n            Shop All\n          <\/a>\n        <\/li>\n\n        <li>\n          <a href=\"\/pages\/contact\">\n            Contact Us\n          <\/a>\n        <\/li>\n\n      <\/ul>\n\n      <!-- Mobile account -->\n      <a\n        class=\"tv-drawer__account\"\n        href=\"{{ routes.account_url }}\"\n      >\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n          <circle cx=\"12\" cy=\"8\" r=\"3.2\"><\/circle>\n          <path d=\"M5.5 20c.7-4 3-6 6.5-6s5.8 2 6.5 6\"><\/path>\n        <\/svg>\n\n        Account & Order History\n      <\/a>\n\n    <\/div>\n  <\/aside>\n\n<\/header>\n\n<script>\n  (() => {\n    const header = document.getElementById(\n      'tv-header-{{ section.id }}'\n    );\n\n    if (!header || header.dataset.initialized === 'true') {\n      return;\n    }\n\n    header.dataset.initialized = 'true';\n\n    \/* =====================================================\n       MOBILE MENU\n    ===================================================== *\/\n\n    const openButton =\n      header.querySelector('[data-tv-menu-open]');\n\n    const closeButtons =\n      header.querySelectorAll('[data-tv-menu-close]');\n\n    const drawer =\n      header.querySelector('.tv-drawer');\n\n    const openMenu = () => {\n      header.classList.add('is-menu-open');\n\n      openButton?.setAttribute(\n        'aria-expanded',\n        'true'\n      );\n\n      drawer?.setAttribute(\n        'aria-hidden',\n        'false'\n      );\n\n      document.documentElement.style.overflow =\n        'hidden';\n    };\n\n    const closeMenu = () => {\n      header.classList.remove('is-menu-open');\n\n      openButton?.setAttribute(\n        'aria-expanded',\n        'false'\n      );\n\n      drawer?.setAttribute(\n        'aria-hidden',\n        'true'\n      );\n\n      document.documentElement.style.overflow =\n        '';\n    };\n\n    openButton?.addEventListener(\n      'click',\n      openMenu\n    );\n\n    closeButtons.forEach((button) => {\n      button.addEventListener(\n        'click',\n        closeMenu\n      );\n    });\n\n    document.addEventListener(\n      'keydown',\n      (event) => {\n        if (event.key === 'Escape') {\n          closeMenu();\n        }\n      }\n    );\n\n    window.addEventListener(\n      'resize',\n      () => {\n        if (window.innerWidth > 749) {\n          closeMenu();\n        }\n      }\n    );\n\n    \/* =====================================================\n       CART DRAWER + LIVE BADGE\n       - Icon gio: mo cart drawer cua theme (moi kien truc:\n         Dawn <cart-drawer>, Horizon <cart-drawer-component>,\n         cart-notification). Theme khong co drawer → ve \/cart.\n       - Badge: tu dong cap nhat sau moi lan cart thay doi\n         (them tu hero section, doi so luong trong drawer...).\n       - Drawer dang DONG thi tu render lai noi dung cho moi.\n    ===================================================== *\/\n\n    const findCartDrawer = () =>\n      document.querySelector(\n        'cart-drawer, cart-drawer-component, cart-notification'\n      );\n\n    const cartDrawerIsOpen = (el) => {\n      if (!el) return false;\n\n      if (el.hasAttribute('open')) return true;\n\n      const dialog = el.querySelector('dialog');\n      if (dialog && dialog.open) return true;\n\n      return (\n        el.classList.contains('active') ||\n        el.classList.contains('is-open') ||\n        el.classList.contains('animate')\n      );\n    };\n\n    const openCartDrawer = () => {\n      const el = findCartDrawer();\n\n      if (!el) return false;\n\n      try {\n        if (typeof el.open === 'function') {\n          el.open();\n          return true;\n        }\n\n        if (typeof el.show === 'function') {\n          el.show();\n          return true;\n        }\n\n        const dialog = el.querySelector('dialog');\n\n        if (\n          dialog &&\n          typeof dialog.showModal === 'function'\n        ) {\n          if (!dialog.open) dialog.showModal();\n          return true;\n        }\n\n        el.classList.add('animate', 'active');\n        document.body.classList.add('overflow-hidden');\n        return true;\n      } catch (error) {\n        return false;\n      }\n    };\n\n    const cartLink =\n      header.querySelector('[data-tv-cart-open]');\n\n    cartLink?.addEventListener('click', (event) => {\n      if (!findCartDrawer()) {\n        return; \/* khong co drawer → di theo link \/cart *\/\n      }\n\n      event.preventDefault();\n\n      if (!openCartDrawer()) {\n        window.location.href =\n          cartLink.getAttribute('href');\n      }\n    });\n\n    \/* ---------- Badge count ---------- *\/\n\n    const setCartCount = (value) => {\n      const badge =\n        header.querySelector('[data-tv-cart-count]');\n\n      if (!badge) return;\n\n      const count = parseInt(value, 10) || 0;\n\n      badge.textContent = count;\n      badge.toggleAttribute('hidden', count === 0);\n    };\n\n    const refreshCartCount = () => {\n      fetch('{{ routes.cart_url }}.js', {\n        headers: { Accept: 'application\/json' }\n      })\n        .then((response) => response.json())\n        .then((cart) => {\n          if (cart && typeof cart.item_count !== 'undefined') {\n            setCartCount(cart.item_count);\n          }\n        })\n        .catch(() => {});\n    };\n\n    \/* ---------- Lam moi noi dung drawer khi dang dong ---------- *\/\n\n    const refreshDrawerSection = () => {\n      const el = findCartDrawer();\n\n      if (!el || cartDrawerIsOpen(el)) return;\n\n      const wrapper =\n        el.closest('[id^=\"shopify-section-\"]');\n\n      if (!wrapper) return;\n\n      const sectionId =\n        wrapper.id.replace('shopify-section-', '');\n\n      fetch(\n        window.location.pathname +\n          '?sections=' +\n          encodeURIComponent(sectionId)\n      )\n        .then((response) => response.json())\n        .then((json) => {\n          const html = json && json[sectionId];\n          const target =\n            document.getElementById(wrapper.id);\n\n          \/* drawer da duoc mo trong luc cho fetch → bo qua,\n             tranh thay DOM lam drawer dong lai *\/\n          if (\n            !html ||\n            !target ||\n            cartDrawerIsOpen(findCartDrawer())\n          ) {\n            return;\n          }\n\n          const doc = new DOMParser().parseFromString(\n            html,\n            'text\/html'\n          );\n\n          const fresh =\n            doc.getElementById(wrapper.id) || doc.body;\n\n          target.innerHTML = fresh.innerHTML;\n        })\n        .catch(() => {});\n    };\n\n    \/* ---------- Theo doi moi thay doi cua cart ---------- *\/\n\n    if (!window.__tvCartWatcher) {\n      window.__tvCartWatcher = true;\n\n      const originalFetch = window.fetch;\n\n      window.fetch = function () {\n        let url = '';\n\n        try {\n          url =\n            typeof arguments[0] === 'string'\n              ? arguments[0]\n              : (arguments[0] && arguments[0].url) || '';\n        } catch (error) {\n          url = '';\n        }\n\n        const result =\n          originalFetch.apply(this, arguments);\n\n        if (\/\\\/cart\\\/(add|change|update|clear)\/.test(url)) {\n          result\n            .then((response) => {\n              if (response && response.ok) {\n                refreshCartCount();\n                refreshDrawerSection();\n              }\n            })\n            .catch(() => {});\n        }\n\n        return result;\n      };\n    }\n\n    ['cart:update', 'cart:updated', 'cart:refresh'].forEach(\n      (name) => {\n        document.addEventListener(name, refreshCartCount);\n      }\n    );\n\n    \/* Quay lai tu trang khac (bfcache) van dung so luong *\/\n    window.addEventListener('pageshow', refreshCartCount);\n  })();\n<\/script>","color_scheme":"","padding_top":40,"padding_bottom":52}}},"order":["announcement-bar","header","custom_liquid_6C3twy","custom_liquid_B7XHEh"]}